  // ==================== УПРАВЛЕНИЕ СТРАНИЦАМИ ====================
  window.showPage = function(page){
    document.getElementById('mainApp').classList.add('hidden');
    document.getElementById('pageAbout').classList.add('hidden');
    document.getElementById('pageContacts').classList.add('hidden');
    document.getElementById('pagePrivacy').classList.add('hidden');
    
    if (page === 'main') document.getElementById('mainApp').classList.remove('hidden');
    if (page === 'about') document.getElementById('pageAbout').classList.remove('hidden');
    if (page === 'contacts') document.getElementById('pageContacts').classList.remove('hidden');
    if (page === 'privacy') document.getElementById('pagePrivacy').classList.remove('hidden');
    
    window.scrollTo({top:0, behavior:'smooth'});
  };

  document.getElementById('logoHome').addEventListener('click', () => showPage('main'));

  // ==================== ВЫБОР ВОЗРАСТА ====================
  ageGrid.innerHTML = AGES.map(a => `
    <button class="age-card" data-age="${a.id}" type="button">
      <strong>${a.title}</strong>
      <span>${a.sub}</span>
    </button>
  `).join('');

  ageGrid.addEventListener('click', (e) => {
    const btn = e.target.closest('.age-card');
    if (!btn) return;
    currentAge = AGES.find(a => a.id === btn.dataset.age);
    if (!currentAge) return;
    try { localStorage.setItem(STORAGE_AGE, currentAge.id); } catch(_){}
    agePill.textContent = 'возраст: ' + currentAge.title;
    startQuiz();
  });

  // ==================== ТЕСТ ====================
  function startQuiz(){
    qIndex = 0;
    score = 0;
    answered = false;
    currentTotal = currentAge.questions.length;
    screenAge.classList.add('hidden');
    screenResult.classList.add('hidden');
    screenQuiz.classList.remove('hidden');
    renderQuestion();
    window.scrollTo({top:0, behavior:'smooth'});
  }

  function renderQuestion(){
    answered = false;
    const q = currentAge.questions[qIndex];
    qNum.textContent = `Вопрос ${qIndex + 1} из ${currentTotal}`;
    qText.textContent = q.q;
    progressBar.style.width = ((qIndex) / currentTotal * 100) + '%';
    answers.innerHTML = q.a.map((text, i) => `
      <button class="answer" data-i="${i}" type="button">${text}</button>
    `).join('');
    answers.querySelectorAll('.answer').forEach(btn => {
      btn.addEventListener('click', () => onAnswer(Number(btn.dataset.i), q));
    });
    const card = $('#questionCard');
    card.style.animation = 'none';
    void card.offsetWidth;
    card.style.animation = 'fadeUp .4s ease both';
  }

  function onAnswer(i, q){
    if (answered) return;
    answered = true;
    const buttons = answers.querySelectorAll('.answer');
    buttons.forEach(b => b.disabled = true);
    const correct = q.correct;
    if (i === correct) score++;
    buttons.forEach((b, idx) => {
      if (idx === correct) b.classList.add('correct');
      else if (idx === i) b.classList.add('wrong');
    });
    const why = document.createElement('div');
    why.className = 'why';
    why.textContent = '💡 ' + q.why;
    answers.appendChild(why);

    setTimeout(() => {
      qIndex++;
      if (qIndex < currentTotal) renderQuestion();
      else showResult();
    }, 1600);
  }

  // ==================== РЕЗУЛЬТАТ ====================
  function getResultMeta(pct){
    if (pct >= 90) return {emoji:'🧠', title:'Финансовый джедай', desc:'Ты понимаешь деньги лучше 90% людей своего возраста. Осталось только применять.'};
    if (pct >= 75) return {emoji:'💪', title:'Крепкий середняк', desc:'База есть, но пара привычек может стоить тебе денег. Смотри уроки ниже.'};
    if (pct >= 50) return {emoji:'🌱', title:'Есть куда расти', desc:'Ты не один — так у большинства. Главное — начать с малого.'};
    return {emoji:'📄', title:'Чистый лист', desc:'Это даже плюс: нет вредных привычек, которые надо ломать. Начни с первого урока.'};
  }

  function showResult(){
    screenQuiz.classList.add('hidden');
    screenResult.classList.remove('hidden');
    const pct = Math.round(score / currentTotal * 100);
    const meta = getResultMeta(pct);

    resultEmoji.textContent = meta.emoji;
    scoreText.innerHTML = `${score}<small>/${currentTotal}</small>`;
    resultBar.style.width = pct + '%';
    resultTitle.textContent = meta.title;
    resultDesc.textContent = meta.desc;

    avgBlock.innerHTML = `Ориентир для возраста <strong>${currentAge.title}</strong> — <strong>${currentAge.avg}/${currentTotal}</strong>. Ты ${score >= currentAge.avg ? 'на уровне или выше' : 'пока ниже — но это легко исправить'}.`;

    tipsList.innerHTML = currentAge.questions.slice(0, 4).map(q => `<li>${q.why}</li>`).join('');
    lessonsBox.innerHTML = currentAge.lessons.map(l => `
      <div class="lesson"><h4>${l.t}</h4><p>${l.d}</p></div>
    `).join('');

    $('#resultBadge').textContent = 'Возраст: ' + currentAge.title;

    const leadAge = document.getElementById('leadAge');
    const leadScore = document.getElementById('leadScore');
    if (leadAge) leadAge.value = currentAge.title;
    if (leadScore) leadScore.value = `${score}/${currentTotal}`;

    otherAgesRow.innerHTML = AGES.filter(a => a.id !== currentAge.id).map(a => `
      <button class="btn ghost" data-age="${a.id}" type="button" style="font-size:13.5px;padding:10px 14px">${a.title}</button>
    `).join('');
    otherAgesRow.querySelectorAll('button').forEach(btn => {
      btn.addEventListener('click', () => {
        currentAge = AGES.find(a => a.id === btn.dataset.age);
        agePill.textContent = 'возраст: ' + currentAge.title;
        startQuiz();
      });
    });

    if (score >= 6) launchConfetti();

    const card = $('#resultCard');
    card.style.animation = 'none';
    void card.offsetWidth;
    card.style.animation = 'fadeUp .6s ease both';

    window.scrollTo({top:0, behavior:'smooth'});
  }

  // ==================== КОНФЕТТИ ====================
  function launchConfetti(){
    const box = $('#confettiBox');
    box.classList.remove('hidden');
    box.innerHTML = '';
    const colors = ['#6ee7b7','#60a5fa','#f472b6','#fbbf24','#a78bfa'];
    for (let i = 0; i < 60; i++){
      const el = document.createElement('i');
      el.style.left = Math.random() * 100 + '%';
      el.style.background = colors[Math.floor(Math.random() * colors.length)];
      el.style.animationDuration = (1.6 + Math.random() * 1.6) + 's';
      el.style.animationDelay = (Math.random() * 0.6) + 's';
      el.style.transform = 'rotate(' + Math.random() * 360 + 'deg)';
      box.appendChild(el);
    }
    setTimeout(() => { box.classList.add('hidden'); box.innerHTML = ''; }, 3800);
  }

  // ==================== ГЕНЕРАЦИЯ КАРТИНКИ ====================
  document.getElementById('downloadImageBtn')?.addEventListener('click', async () => {
    if (!currentAge) return;
    await document.fonts.ready;
    
    const canvas = document.createElement('canvas');
    const ctx = canvas.getContext('2d');
    const W = 1080, H = 1080;
    canvas.width = W; canvas.height = H;

    const grad = ctx.createLinearGradient(0, 0, W, H);
    grad.addColorStop(0, '#0f1220');
    grad.addColorStop(1, '#171b2e');
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, W, H);

    const glow1 = ctx.createRadialGradient(200, 0, 0, 200, 0, 800);
    glow1.addColorStop(0, 'rgba(96,165,250,.25)');
    glow1.addColorStop(1, 'rgba(96,165,250,0)');
    ctx.fillStyle = glow1;
    ctx.fillRect(0, 0, W, H);

    const glow2 = ctx.createRadialGradient(800, 800, 0, 800, 800, 600);
    glow2.addColorStop(0, 'rgba(110,231,183,.2)');
    glow2.addColorStop(1, 'rgba(110,231,183,0)');
    ctx.fillStyle = glow2;
    ctx.fillRect(0, 0, W, H);

    ctx.fillStyle = '#6ee7b7';
    ctx.beginPath(); ctx.arc(90, 90, 12, 0, Math.PI * 2); ctx.fill();
    ctx.fillStyle = '#eef1f8';
    ctx.font = '800 32px "Manrope", sans-serif';
    ctx.fillText('ФинГрамотность', 120, 102);

    ctx.fillStyle = 'rgba(255,255,255,.5)';
    ctx.font = '600 28px "Manrope", sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText(`Возрастная группа: ${currentAge.title}`, W/2, 300);

    ctx.font = '120px "Manrope", sans-serif';
    ctx.fillText(resultEmoji.textContent, W/2, 480);

    ctx.fillStyle = '#eef1f8';
    ctx.font = '800 180px "Manrope", sans-serif';
    ctx.fillText(`${score}`, W/2 - 60, 680);
    ctx.fillStyle = 'rgba(255,255,255,.3)';
    ctx.font = '600 60px "Manrope", sans-serif';
    ctx.fillText(`/${currentTotal}`, W/2 + 90, 680);

    ctx.fillStyle = '#6ee7b7';
    ctx.font = '700 48px "Manrope", sans-serif';
    ctx.fillText(resultTitle.textContent, W/2, 780);

    ctx.fillStyle = 'rgba(255,255,255,.7)';
    ctx.font = '400 32px "Manrope", sans-serif';
    const desc = resultDesc.textContent;
    const maxWidth = 800;
    let words = desc.split(' ');
    let line = '';
    let y = 850;
    for (let n = 0; n < words.length; n++) {
      let testLine = line + words[n] + ' ';
      let metrics = ctx.measureText(testLine);
      if (metrics.width > maxWidth && n > 0) {
        ctx.fillText(line, W/2, y);
        line = words[n] + ' ';
        y += 45;
      } else {
        line = testLine;
      }
    }
    ctx.fillText(line, W/2, y);

    ctx.fillStyle = 'rgba(255,255,255,.4)';
    ctx.font = '500 24px "Manrope", sans-serif';
    ctx.fillText('Проверь себя на нашем сайте!', W/2, 1000);

    const link = document.createElement('a');
    link.download = `fingramotnost-result-${score}.png`;
    link.href = canvas.toDataURL('image/png');
    link.click();
  });

  // ==================== ПЕРЕЗАПУСК ====================
  function backToAgeSelect(){
    screenQuiz.classList.add('hidden');
    screenResult.classList.add('hidden');
    screenAge.classList.remove('hidden');
    agePill.textContent = 'возраст не выбран';
    try { localStorage.removeItem(STORAGE_AGE); } catch(_){}
    window.scrollTo({top:0, behavior:'smooth'});
  }
  $('#restartBtn')?.addEventListener('click', backToAgeSelect);
  $('#restartBtn2')?.addEventListener('click', backToAgeSelect);
  $('#retakeBtn')?.addEventListener('click', () => { if (currentAge) startQuiz(); });

  // ==================== ШАРИНГ ====================
  async function doShare(text, title){
    const url = location.href;
    if (navigator.share){
      try { await navigator.share({title: title || 'ФинГрамотность', text, url}); return; } 
      catch(e) { if(e.name !== 'AbortError') console.warn('Share failed', e); }
    }
    try {
      await navigator.clipboard.writeText(text + ' ' + url);
      alert('Скопировано в буфер обмена! Вставь в чат.');
    } catch(_){ alert(text + '\n' + url); }
  }

  $('#shareChallenge')?.addEventListener('click', () => {
    const text = `Я прошёл тест на финграмотность (возраст ${currentAge.title}) — ${score}/${currentTotal}. Слабо побить?`;
    doShare(text, 'Бросить вызов');
  });

  $('#shareFamily')?.addEventListener('click', () => {
    const text = `Прошёл тест на финграмотность (возраст ${currentAge.title}) — ${score}/${currentTotal}. Пройди тоже, интересно сравнить!`;
    doShare(text, currentAge.familyLabel || 'Поделиться');
  });

  $('#shareCopy')?.addEventListener('click', async () => {
    const text = `Мой результат: ${score}/${currentTotal} (возраст ${currentAge.title}) — тест на финграмотность`;
    try {
      await navigator.clipboard.writeText(text + ' ' + location.href);
      alert('Результат скопирован!');
    } catch(_){ alert(text + '\n' + location.href); }
  });

  // ==================== ВОССТАНОВЛЕНИЕ ВОЗРАСТА ====================
  try {
    const saved = localStorage.getItem(STORAGE_AGE);
    if (saved){
      const found = AGES.find(a => a.id === saved);
      if (found){
        currentAge = found;
        agePill.textContent = 'возраст: ' + found.title;
      }
    }
  } catch(_){}

  // ==================== COOKIE BANNER ====================
  const COOKIE_KEY = 'fg_cookie_consent';
  const cookieBanner = document.getElementById('cookieBanner');
  try {
    if (!localStorage.getItem(COOKIE_KEY) && cookieBanner) {
      setTimeout(() => cookieBanner.classList.remove('hidden'), 1000);
    }
  } catch(_){}

  function setCookieConsent(value){
    try { localStorage.setItem(COOKIE_KEY, value); } catch(_){}
    if (cookieBanner) cookieBanner.classList.add('hidden');
  }

  document.getElementById('cookieAccept')?.addEventListener('click', () => setCookieConsent('all'));
  document.getElementById('cookieReject')?.addEventListener('click', () => setCookieConsent('necessary'));

  // ==================== ДАТА И ГОД ====================
  const yearEl = $('#year');
  if (yearEl) yearEl.textContent = new Date().getFullYear();
  const dateEl = $('#d');
  if (dateEl) dateEl.textContent = new Date().toLocaleDateString('ru-RU');

})();
</script>
</body>
</html>
